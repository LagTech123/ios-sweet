--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1850,24 +1850,35 @@
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
  */
+/*
+ * The early console paints the whole 1080x1920 panel: 4352 bytes of stride
+ * times 1920 lines is 0x7F8000 bytes, and the per-marker colour swatch lives
+ * on the last 32 lines, i.e. 8.2MB into the framebuffer. A single 2MB alias
+ * therefore faults on the very first swatch store after the TTBR1 switch
+ * (marker 9 never printed). Cover the full 8MB with four 2MB blocks and move
+ * the pstore alias above them.
+ */
+#define SWEET_EARLY_FB_BLOCKS 4u
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
-#define SWEET_EARLY_PSTORE_VA (VM_MIN_KERNEL_ADDRESS + 2 * ARM_TT_L2_SIZE)
+#define SWEET_EARLY_PSTORE_VA (SWEET_EARLY_FB_VA + SWEET_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE)
 
 static void
 sweet_early_map_final(void)
 {
-	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
-	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
-	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
-	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
-	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x83400000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
-	sweet_early_mark(37, "map_final: framebuffer alias mapped");
+	for (unsigned int i = 0; i < SWEET_EARLY_FB_BLOCKS; i++) {
+		const vm_map_address_t va = SWEET_EARLY_FB_VA + i * ARM_TT_L2_SIZE;
+		assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+		tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+		assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+		tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+		tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		assert(*slot == ARM_TTE_EMPTY);
+		*slot = (0x83400000ULL + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	sweet_early_mark(37, "map_final: framebuffer alias mapped (4x2MB)");
 
 	const vm_map_address_t pstore_va = SWEET_EARLY_PSTORE_VA;
 	assert(pstore_va + ARM_TT_L2_SIZE <= gVirtBase);
