 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x83401000;
 #define EARLY_FB early_fb
+
+/* Mirror the early console into the MSM8996 ramoops zone so a bare-metal
+ * XNU boot can be diagnosed after the SoC resets. */
+#define EARLY_PSTORE_SIZE 0x40000u
+#define EARLY_PSTORE_MAGIC 0x43474244u
+static volatile uint8_t *early_pstore = (volatile uint8_t *)(uintptr_t)0xa7fbe000UL;
+static unsigned int early_pstore_len;
+
+static void
+sweet_early_pstore_putc(char c)
+{
+	volatile uint32_t *header = (volatile uint32_t *)early_pstore;
+
+	if (!early_pstore || early_pstore_len >= EARLY_PSTORE_SIZE - 12) {
+		return;
+	}
+	early_pstore[12 + early_pstore_len++] = (uint8_t)c;
+	header[0] = 0;
+	header[1] = 0;
+	header[2] = early_pstore_len;
+	__asm__ volatile("dsb sy" ::: "memory");
+	header[0] = EARLY_PSTORE_MAGIC;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_set_pstore(uint64_t base)
+{
+	early_pstore = (volatile uint8_t *)(uintptr_t)base;
+	early_pstore_len = 0;
+}
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 1920u
 #define EARLY_STRIDE (4352u / 4)
