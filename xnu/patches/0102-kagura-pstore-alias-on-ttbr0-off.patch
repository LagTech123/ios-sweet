 {
 	volatile uint32_t *header = (volatile uint32_t *)early_pstore;
 
-	if (early_ttbr0_off || !early_pstore || early_pstore_len >= EARLY_PSTORE_SIZE - 12) {
+	if (!early_pstore || early_pstore_len >= EARLY_PSTORE_SIZE - 12) {
 		return;
 	}
 	early_pstore[12 + early_pstore_len++] = (uint8_t)c;
 	header[0] = 0;
@@ -77,10 +83,16 @@
 static unsigned int early_started, early_disabled, early_panicking;
 void
 sweet_early_note_ttbr0_off(void)
 {
+	if (early_ttbr0_off) {
+		return;
+	}
 	early_ttbr0_off = 1;
-	__asm__ volatile("dsb sy" ::: "memory");
+	early_fb_off = 1;
+	early_pstore = (volatile uint8_t *)(uintptr_t)SWEET_EARLY_PSTORE_ALIAS_VA;
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_mark(66, "TTBR0 off: pstore switched to high VA alias");
 }
 
 static void
 sweet_early_clear_row(void)
@@ -99,8 +111,11 @@
 	if (early_disabled || early_ttbr0_off) {
 		return;
 	}
 	sweet_early_pstore_putc(c == '\r' ? '\n' : c);
+	if (early_fb_off) {
+		return;
+	}
 	if (!early_started) {
 		early_started = 1;
 		sweet_early_clear_row();
 	}
