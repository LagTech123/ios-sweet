--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -22,8 +22,14 @@
 static unsigned int early_pstore_len;
 
 /* 0098: set when pmap is about to kill the bootstrap (identity) TTBR0. */
 static unsigned int early_ttbr0_off;
+/* 0102: TTBR1 high-VA alias for the ramoops console zone.  The 0084 L2 TTE
+ * maps PA 0xa6000000 for SWEET_EARLY_PSTORE_VA (VM_MIN + 64 MB) because the
+ * 32 MB L2 block ignores the low bits of 0xa7f00000.  The console zone lives
+ * at PA 0xa7fbe000, i.e. +0x01fbe000 into that block. */
+#define SWEET_EARLY_PSTORE_ALIAS_VA 0xfffffe0005fbe000ULL
+static unsigned int early_fb_off;
 /* 0101: only tee kprintf/printf after marker 60 (pstore is 256 KB). */
 static unsigned int early_tee_on;
 
