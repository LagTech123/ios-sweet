+/* 0139: ml_io_map() is declared only for MACH_KERNEL_PRIVATE /
+ * PEXPERT_KERNEL_PRIVATE builds; IOKit is neither. The symbol is linked into
+ * the kernel by osfmk/arm64/sweet_early.c, so declare it here explicitly. */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*
+ * 0139: disarm the kagura shim's watchdog from inside XNU. The good p30
+ * rootlayout shim arms two safety nets just before jumping here:
+ *   CPU3  : delay_ms(40000) -> if (!watchdog_cancelled) PSCI_SYSTEM_RESET
+ *   HW WDT: qcom,wdt@9830000 (0x09830000), bark 60 s / bite 63 s
+ * Only the shim's own dsi.c can set watchdog_cancelled, and that path never
+ * runs on the XNU boot. Ship sailfish's WDT_SECS=0 equivalent from userland:
+ *   physical 0x80098010 = 0x80080000 (shim load) + 0x18010 (BSS symbol
+ *                         watchdog_cancelled) -> 1 stops the CPU3 reset;
+ *   physical 0x09830008 = MSM_WDT + WDT_EN -> 0 disables the hardware timer.
+ * ml_io_map gives an uncached device mapping for both writes. Writing
+ * watchdog_armed would do nothing (CPU3 tests it only before the delay).
+ */
+static void
+sweet_wdt_disarm_shim(void)
+{
+	volatile uint32_t *flag = (volatile uint32_t *)
+	    ml_io_map(0x80098010UL, 0x1000);
+	volatile uint32_t *wdt = (volatile uint32_t *)
+	    ml_io_map(0x09830000UL, 0x1000);
+	if (flag != NULL) {
+		*flag = 1u;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (wdt != NULL) {
+		wdt[0x08 / 4] = 0u;             /* WDT_EN */
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	IOLog("SWEET WDT: shim watchdog disarmed (flag %s, WDT_EN %s)\n",
+	    flag != NULL ? "ok" : "FAILED", wdt != NULL ? "ok" : "FAILED");
+}
 
 class IOWatchdog : public IOService {
 	OSDeclareDefaultStructors(IOWatchdog);
 
