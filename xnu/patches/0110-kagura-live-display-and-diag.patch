@@ -68,8 +72,64 @@
 sweet_early_set_pstore(uint64_t base)
 {
 	early_pstore = (volatile uint8_t *)(uintptr_t)base;
 	early_pstore_len = 0;
+}
+
+/* 0110: MDSS/DSI MMIO pages, mapped once the kernel MMU and pmap are live.
+ * The shim configured RGB0 -> LM0 -> INTF1 -> DSI0 (command mode) and set
+ * PP0 autorefresh before XNU started; we only re-arm autorefresh here and
+ * replay its two-register frame commit. Write-only: raw MDSS reads are
+ * forbidden on this SoC (bus hang / forced reboot). */
+#define KAGURA_MDP_CTL_PA   0x00900000ULL
+#define KAGURA_MDP_CTL_SZ   0x3000u      /* INTF_SEL, INTR, CTL0 */
+#define KAGURA_MDP_PP_PA    0x00971000ULL
+#define KAGURA_MDP_PP_SZ    0x1000u      /* PP0_AUTOREFRESH */
+#define CTL0_FLUSH_OFF      0x2018u
+#define CTL0_START_OFF      0x201cu
+#define PP0_AUTOREFRESH_OFF 0x0030u
+#define CTL_FLUSH_CFG       0x00020048U  /* CTL_TOP | LM0 | RGB0 */
+#define CTL_START_GO        0x00000001U
+#define PP0_AUTOREFRESH_ON  0x80000001U
+
+static volatile uint32_t *kagura_mdp_ctl;
+static volatile uint32_t *kagura_mdp_pp;
+static unsigned int kagura_display_ready;
+
+void
+sweet_early_display_init(void)
+{
+	if (kagura_display_ready) {
+		return;
+	}
+	kagura_mdp_ctl = (volatile uint32_t *)ml_io_map(KAGURA_MDP_CTL_PA, KAGURA_MDP_CTL_SZ);
+	kagura_mdp_pp  = (volatile uint32_t *)ml_io_map(KAGURA_MDP_PP_PA, KAGURA_MDP_PP_SZ);
+	kagura_display_ready = 1;
+	if (kagura_mdp_pp) {
+		kagura_mdp_pp[PP0_AUTOREFRESH_OFF / 4] = PP0_AUTOREFRESH_ON;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+static void
+sweet_early_display_commit(void)
+{
+	if (!kagura_display_ready || !kagura_mdp_ctl) {
+		return;
+	}
+	/* Exact shim kickoff: CTL0_FLUSH then CTL0_START, no MMIO reads. */
+	kagura_mdp_ctl[CTL0_FLUSH_OFF / 4] = CTL_FLUSH_CFG;
+	__asm__ volatile("dsb sy" ::: "memory");
+	kagura_mdp_ctl[CTL0_START_OFF / 4] = CTL_START_GO;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_early_pstore_string(const char *s)
+{
+	while (*s) {
+		sweet_early_pstore_putc(*s++);
+	}
 }
