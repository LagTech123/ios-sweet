+/* 0159: before the filesystem trusts ADMA2, compare 128 KiB PIO vs DMA. */
+static void
+kemmc_adma_selftest(void)
+{
+	const uint32_t blocks = 256u;
+	const uint32_t bytes = blocks * KEMMC_SECTOR;
+	uint8_t *pio_buf = kemmc_multi_bounce;
+	uint8_t *dma_buf = kemmc_multi_bounce + bytes;
+	uint64_t base_pa = (uint64_t)(uintptr_t)ml_vtophys(
+	    (vm_offset_t)kemmc_multi_bounce);
+	int perr, derr;
+
+	if (kemmc_nsectors < blocks + 8u) {
+		return;
+	}
+	memset(dma_buf, 0x5a, bytes);
+	lck_mtx_lock(&kemmc_lock);
+	perr = emmc_read_multi_pio((uint32_t)kemmc_first_lba, blocks, pio_buf);
+	derr = emmc_read_multi_adma((uint32_t)kemmc_first_lba, blocks,
+	    dma_buf, base_pa + bytes);
+	lck_mtx_unlock(&kemmc_lock);
+	printf("KAGURA eMMC: ADMA2 self-test 128 KiB: PIO %d ADMA2 %d data %s\n",
+	    perr, derr, (!perr && !derr && memcmp(pio_buf, dma_buf, bytes) == 0) ?
+	    "IDENTICAL" : "DIFFERENT");
+	if (perr || derr || memcmp(pio_buf, dma_buf, bytes) != 0) {
+		kemmc_adma_on = false;
+		printf("KAGURA eMMC: ADMA2 read path left OFF (self-test failed)\n");
+	}
 }
 
