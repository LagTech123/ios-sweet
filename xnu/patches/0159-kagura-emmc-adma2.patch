+/* 0159: one CMD18/CMD17 into dst using ADMA2; dst_pa is its physical address. */
+static int
+emmc_read_multi_adma(uint32_t lba, uint32_t nsect, uint8_t *dst,
+    uint64_t dst_pa)
+{
+	uint32_t enable, signal, status;
+	uint32_t ndesc = 0;
+	size_t remain = (size_t)nsect * KEMMC_SECTOR;
+	uint8_t hc;
+	int error = 0;
+
+	if (!kemmc_adma_on || nsect == 0 || nsect > KEMMC_MULTI_MAX) {
+		return EINVAL;
+	}
+	if (dst_pa + remain > 0x100000000ull) {
+		return EINVAL;
+	}
+	error = emmc_wait_idle();
+	if (error) {
+		return error;
+	}
+	enable = emmc_rd32(SDHCI_INT_ENABLE);
+	signal = emmc_rd32(SDHCI_SIGNAL_ENABLE);
+	emmc_wr32(SDHCI_INT_ENABLE, 0x01ff00ffu);
+	emmc_wr32(SDHCI_SIGNAL_ENABLE, 0);
+	emmc_wr32(SDHCI_INT_STATUS, emmc_rd32(SDHCI_INT_STATUS));
+
+	while (remain != 0) {
+		size_t len = MIN(remain, ADMA_CHUNK);
+		uint16_t attr = ADMA_ATTR_VALID | ADMA_ATTR_TRAN;
+
+		if (len == remain) {
+			attr |= ADMA_ATTR_END;
+		}
+		kemmc_adma_desc[ndesc].attr = attr;
+		kemmc_adma_desc[ndesc].len = (uint16_t)len;
+		kemmc_adma_desc[ndesc].addr = (uint32_t)dst_pa;
+		ndesc++;
+		dst_pa += len;
+		remain -= len;
+	}
+	/* The host is not cache coherent: descriptors and data must reach DRAM. */
+	flush_dcache64((addr64_t)(uintptr_t)kemmc_adma_desc,
+	    (unsigned)(ndesc * sizeof(*kemmc_adma_desc)), FALSE);
+	flush_dcache64((addr64_t)(uintptr_t)dst,
+	    (unsigned)(nsect * KEMMC_SECTOR), FALSE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	hc = emmc_rd8(SDHCI_HOST_CONTROL);
+	emmc_wr8(SDHCI_HOST_CONTROL, (uint8_t)((hc & ~0x18u) | SDHCI_CTRL_ADMA2_32));
+	emmc_wr32(SDHCI_ADMA_SYS_ADDR,
+	    (uint32_t)(uintptr_t)ml_vtophys((vm_offset_t)kemmc_adma_desc));
+	emmc_wr16(SDHCI_BLOCK_SIZE, (uint16_t)KEMMC_SECTOR);
+	emmc_wr16(SDHCI_BLOCK_COUNT, (uint16_t)nsect);
+	emmc_wr32(SDHCI_ARGUMENT, lba);
+	emmc_wr8(SDHCI_TRANSFER_MODE, (uint8_t)(TRNS_DMA | TRNS_READ |
+	    TRNS_BLK_CNT_EN | TRNS_MULTI | TRNS_AUTO_CMD12));
+	emmc_wr16(SDHCI_COMMAND, (uint16_t)((18u << 8) | CMD_RESP_SHORT |
+	    CMD_CRC | CMD_INDEX | CMD_DATA));
+
+	kemmc_dbg_lba = lba;
+	kemmc_dbg_nsec += nsect;
+	for (unsigned i = 0; i < KEMMC_TIMEOUT; i++) {
+		status = emmc_rd32(SDHCI_INT_STATUS);
+		if (status & INT_ERROR_MASK) {
+			printf("KAGURA eMMC: ADMA2 error int=%x adma=%x state=%x\n",
+			    status, emmc_rd32(SDHCI_ADMA_ERROR),
+			    emmc_rd32(SDHCI_PRESENT_STATE));
+			error = EIO;
+			break;
+		}
+		if (status & INT_DATA_END) {
+			break;
+		}
+		if (i == KEMMC_TIMEOUT - 1) {
+			printf("KAGURA eMMC: ADMA2 timeout int=%x state=%x\n",
+			    status, emmc_rd32(SDHCI_PRESENT_STATE));
+			error = ETIMEDOUT;
+		}
+	}
+	/* Leave the controller exactly as the PIO path expects it. */
+	emmc_wr8(SDHCI_HOST_CONTROL, hc);
+	emmc_wr32(SDHCI_INT_STATUS, emmc_rd32(SDHCI_INT_STATUS));
+	emmc_wr32(SDHCI_INT_ENABLE, enable);
+	emmc_wr32(SDHCI_SIGNAL_ENABLE, signal);
+	if (error) {
+		emmc_wr8(SDHCI_SOFTWARE_RESET, (uint8_t)(RESET_CMD | RESET_DATA));
+		for (unsigned i = 0; i < KEMMC_TIMEOUT; i++) {
+			if (!(emmc_rd8(SDHCI_SOFTWARE_RESET) &
+			    (RESET_CMD | RESET_DATA))) {
+				break;
+			}
+		}
+		return error;
+	}
+	flush_dcache64((addr64_t)(uintptr_t)dst,
+	    (unsigned)(nsect * KEMMC_SECTOR), FALSE);
+	kemmc_adma_reads++;
+	kemmc_adma_bytes += nsect * KEMMC_SECTOR;
+	return 0;
+}
