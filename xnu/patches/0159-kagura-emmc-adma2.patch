+/* 0159: ADMA2 wrapper with PIO fallback. */
+static int
+emmc_read_multi(uint32_t lba, uint32_t nsect, uint8_t *dst)
+{
+	int error;
+
+	if (kemmc_adma_on && nsect <= KEMMC_MULTI_MAX) {
+		error = emmc_read_multi_adma(lba, nsect, dst,
+		    (uint64_t)(uintptr_t)ml_vtophys((vm_offset_t)dst));
+		if (!error) {
+			return 0;
+		}
+		printf("KAGURA eMMC: ADMA2 failed (%d), falling back to PIO\n", error);
+		kemmc_adma_on = false;
+	}
+	return emmc_read_multi_pio(lba, nsect, dst);
+}
