+#define ADMA_ATTR_END           0x0002u
+#define ADMA_ATTR_TRAN          0x0020u
+#define ADMA_CHUNK              32768u
+#define ADMA_DESC_COUNT         (KEMMC_MULTI_MAX * KEMMC_SECTOR / ADMA_CHUNK)
