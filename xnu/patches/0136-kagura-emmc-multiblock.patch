 /*
+ * 0136: polled PIO CMD18 READ_MULTIPLE_BLOCK. CMD23 SET_BLOCK_COUNT is sent
+ * first (emmccmd23=0 skips it), and SDHCI auto-CMD12 ends the transfer, so no
+ * manual STOP_TRANSMISSION is needed. One command + one wait per batch instead
+ * of one per 512-byte sector -- roughly 10-20x faster for dyld shared-cache
+ * page faults. All clock/timing/bus state is left exactly as ABL set it up.
+ */
+static int
+emmc_read_multi(uint32_t lba, uint32_t nsect, uint8_t *dst)
+{
+	uint32_t enable, signal, status;
+	unsigned words;
+	int error;
+
+	if (nsect == 0 || nsect > KEMMC_MULTI_MAX) {
+		return EINVAL;
+	}
+	error = emmc_wait_idle();
+	if (error) {
+		return error;
+	}
+	enable = emmc_rd32(SDHCI_INT_ENABLE);
+	signal = emmc_rd32(SDHCI_SIGNAL_ENABLE);
+	emmc_wr32(SDHCI_INT_ENABLE, 0x01ff00ffu);
+	emmc_wr32(SDHCI_SIGNAL_ENABLE, 0);
+	status = emmc_rd32(SDHCI_INT_STATUS);
+	emmc_wr32(SDHCI_INT_STATUS, status);
+
+	if (kemmc_do_cmd23) {
+		/* SET_BLOCK_COUNT: no data, short response. */
+		emmc_wr32(SDHCI_ARGUMENT, nsect);
+		emmc_wr16(SDHCI_COMMAND, (uint16_t)((23u << 8) | CMD_RESP_SHORT |
+		    CMD_CRC | CMD_INDEX));
+		for (unsigned i = 0; i < KEMMC_TIMEOUT; i++) {
+			status = emmc_rd32(SDHCI_INT_STATUS);
+			if (status & INT_ERROR_MASK) {
+				printf("KAGURA eMMC: CMD23 error int=%x state=%x\n",
+				    status, emmc_rd32(SDHCI_PRESENT_STATE));
+				error = EIO;
+				goto done;
+			}
+			if (status & INT_RESPONSE) {
+				break;
+			}
+		}
+		emmc_wr32(SDHCI_INT_STATUS, INT_RESPONSE);
+		if (error) {
+			goto done;
+		}
+	}
+
+	emmc_wr16(SDHCI_BLOCK_SIZE, (uint16_t)KEMMC_SECTOR);
+	emmc_wr16(SDHCI_BLOCK_COUNT, (uint16_t)nsect);
+	emmc_wr32(SDHCI_ARGUMENT, lba);
+	emmc_wr8(SDHCI_TRANSFER_MODE, (uint8_t)(TRNS_READ | TRNS_BLK_CNT_EN |
+	    TRNS_MULTI | TRNS_AUTO_CMD12));
+	emmc_wr16(SDHCI_COMMAND, (uint16_t)((18u << 8) | CMD_RESP_SHORT |
+	    CMD_CRC | CMD_INDEX | CMD_DATA));
+
+	kemmc_dbg_lba = lba;
+	kemmc_dbg_nsec += nsect;
+	for (uint32_t s = 0; s < nsect; s++) {
+		words = 0;
+		for (unsigned i = 0; i < KEMMC_TIMEOUT; i++) {
+			status = emmc_rd32(SDHCI_INT_STATUS);
+			if (status & INT_ERROR_MASK) {
+				printf("KAGURA eMMC: CMD18 error s=%u/%u lba=%u int=%x state=%x\n",
+				    s, nsect, lba, status, emmc_rd32(SDHCI_PRESENT_STATE));
+				error = EIO;
+				goto done;
+			}
+			if (status & INT_DATA_AVAIL) {
+				for (unsigned j = 0; j < KEMMC_SECTOR / 4; j++) {
+					((uint32_t *)(dst + (size_t)s * KEMMC_SECTOR))[j] =
+					    emmc_rd32(SDHCI_BUFFER);
+				}
+				words = KEMMC_SECTOR / 4;
+				emmc_wr32(SDHCI_INT_STATUS, INT_DATA_AVAIL);
+				break;
+			}
+		}
+		if (words == 0) {
+			printf("KAGURA eMMC: CMD18 timeout s=%u/%u lba=%u int=%x\n",
+			    s, nsect, lba, status);
+			error = ETIMEDOUT;
+			goto done;
+		}
+	}
+	for (unsigned i = 0; i < KEMMC_TIMEOUT; i++) {
+		status = emmc_rd32(SDHCI_INT_STATUS);
+		if (status & INT_ERROR_MASK) {
+			error = EIO;
+			goto done;
+		}
+		if (status & INT_DATA_END) {
+			break;
+		}
+	}
+done:
+	emmc_wr32(SDHCI_INT_STATUS, emmc_rd32(SDHCI_INT_STATUS));
+	emmc_wr32(SDHCI_INT_ENABLE, enable);
+	emmc_wr32(SDHCI_SIGNAL_ENABLE, signal);
+	return error;
+}
