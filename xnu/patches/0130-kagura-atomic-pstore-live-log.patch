+/*
+ * 0130: redraw the tail of the console ring into the live panel framebuffer.
+ * Only glyphs are written here -- no pstore tee -- so replaying the log does
+ * not duplicate entries in the persistent console.
+ */
+void
+sweet_early_draw_console_tail(const char *buf, unsigned int len)
+{
+	if (early_disabled || early_fb_off || buf == NULL || len == 0) {
+		return;
+	}
+	early_col = 0;
+	early_row = 0;
+	sweet_early_clear_row();
+	for (unsigned int i = 0; i < len; i++) {
+		unsigned char c = (unsigned char)buf[i];
+		if (c == '\n' || c == '\r' || early_col == EARLY_COLS) {
+			early_col = 0;
+			early_row = (early_row + 1) % EARLY_ROWS;
+			sweet_early_clear_row();
+			if (c == '\n' || c == '\r') {
+				continue;
+			}
+		}
+		const unsigned char *glyph = iso_font + c * 16;
