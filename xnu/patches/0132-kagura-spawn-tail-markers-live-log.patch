+/*
+ * 0132: incremental live console on the surface AppleCLCD presents (fPixels).
+ * Every console byte and every pstore marker is drawn as it is logged into a
+ * ring of text rows; a shadow buffer lets present() repaint after a client
+ * blit, and each newline kicks the command-mode panel.  A contended byte is
+ * dropped rather than spun on (interrupt context can re-enter).
+ */
+#define LIVE_MAX_ROWS 64u
+#define LIVE_MAX_COLS 80u
+static volatile uint32_t *live_fb;
+static unsigned int live_stride, live_cols, live_rows, live_row, live_col;
+static char live_text[LIVE_MAX_ROWS][LIVE_MAX_COLS];
+static volatile uint32_t live_lock;
+
+static void
+live_draw_cell(unsigned int row, unsigned int col, unsigned char c)
+{
+	const unsigned char *glyph = iso_font + c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = live_fb +
+			    (row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * live_stride +
+			    col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+}
+
+static void
+live_clear_row(unsigned int row)
+{
+	for (unsigned int col = 0; col < LIVE_MAX_COLS; col++) {
+		live_text[row][col] = ' ';
+	}
+	for (unsigned int col = 0; col < live_cols; col++) {
+		live_draw_cell(row, col, ' ');
+	}
+}
+
+void
+sweet_early_live_set(volatile uint32_t *fb, unsigned int stride_px,
+    unsigned int cols, unsigned int rows)
+{
+	if (fb == NULL || cols == 0 || rows == 0) {
+		return;
+	}
+	while (__sync_lock_test_and_set(&live_lock, 1)) {
+	}
+	live_fb = NULL;
+	live_stride = stride_px;
+	live_cols = cols > LIVE_MAX_COLS ? LIVE_MAX_COLS : cols;
+	live_rows = rows > LIVE_MAX_ROWS ? LIVE_MAX_ROWS : rows;
+	live_row = 0;
+	live_col = 0;
+	live_fb = fb;
+	for (unsigned int r = 0; r < live_rows; r++) {
+		live_clear_row(r);
+	}
+	__sync_lock_release(&live_lock);
+	sweet_early_display_commit();
+}
+
+void
+sweet_early_live_putc(char c)
+{
+	if (live_fb == NULL) {
+		return;
+	}
+	if (__sync_lock_test_and_set(&live_lock, 1)) {
+		return;
+	}
+	if (c != '\r') {
+		if (c == '\n' || live_col >= live_cols) {
+			live_col = 0;
+			live_row = (live_row + 1) % live_rows;
+			live_clear_row(live_row);
+			sweet_early_display_commit();
+		}
+		if (c == '\t') {
+			c = ' ';
+		}
+		if (c != '\n' && (unsigned char)c >= 32 && (unsigned char)c < 127) {
+			live_text[live_row][live_col] = c;
+			live_draw_cell(live_row, live_col, (unsigned char)c);
+			live_col++;
+		}
+	}
+	__sync_lock_release(&live_lock);
+}
+
+void
+sweet_early_live_repaint(void)
+{
+	if (live_fb == NULL || __sync_lock_test_and_set(&live_lock, 1)) {
+		return;
+	}
+	for (unsigned int r = 0; r < live_rows; r++) {
+		for (unsigned int col = 0; col < live_cols; col++) {
+			live_draw_cell(r, col, (unsigned char)live_text[r][col]);
+		}
+	}
+	__sync_lock_release(&live_lock);
+}
