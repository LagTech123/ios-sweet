+/* 0180: runtime XPC service-name trace, gated to SpringBoard and lsd.
+ * The service name for SpringBoard's blocked synchronous XPC request lives only
+ * in its process memory; a static read of plists/strings cannot name it.
+ * kprintf is not mirrored to console-ramoops, so use printf. Separate budgets:
+ * SpringBoard 64, lsd 8 (so SpringBoard's slots cannot be stolen by lsd). */
+static uint32_t kagura_machmsg_sb_count;
+static uint32_t kagura_machmsg_lsd_count;
+
+extern int proc_selfpid(void);
+extern void proc_name(int pid, char *buf, int size);
+
+static inline uint32_t
+kagura_rd32(const char *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static bool
+kagura_has_apple_string(const char *s, int n)
+{
+	int i;
+
+	for (i = 0; i + 10 <= n; i++) {
+		if (strncmp(&s[i], "com.apple.", 10) == 0)
+			return true;
+	}
+	return false;
+}
+
+static void
+kagura_machmsg_trace(user_addr_t msg_addr, uint32_t msgh_bits,
+    uint32_t send_size, uint32_t remote, uint32_t local, uint32_t msgh_id)
+{
+	char pname[32];
+	char buf[256];
+	char runbuf[96];
+	const char *proc;
+	int i, j, n, len;
+
+	proc_name(proc_selfpid(), pname, (int)sizeof(pname));
+	if (strncmp(pname, "SpringBoard", 12) == 0) {
+		proc = "SpringBoard";
+		if (kagura_machmsg_sb_count >= 64)
+			return;
+		kagura_machmsg_sb_count++;
+	} else if (strncmp(pname, "lsd", 4) == 0) {
+		proc = "lsd";
+		if (kagura_machmsg_lsd_count >= 8)
+			return;
+		kagura_machmsg_lsd_count++;
+	} else {
+		return;
+	}
+	if (msg_addr == 0)
+		return;
+	/* A short message followed by an unmapped page makes a 256-byte copyin
+	 * fail and would silently drop the trace; fall back 256 -> 128 -> 64. */
+	for (len = 256; len >= 64; len /= 2) {
+		if (copyin(msg_addr, buf, (size_t)len) == 0)
+			break;
+	}
+	if (len < 64)
+		return;
+	/* Only messages carrying an Apple service name: no CFRunLoop traffic. */
+	if (!kagura_has_apple_string(buf, len))
+		return;
+
+	/* mach_msg_overwrite has its header in the user buffer, not in args. */
+	if (remote == 0 && local == 0 && msgh_id == 0) {
+		remote  = kagura_rd32(&buf[8]);
+		local   = kagura_rd32(&buf[12]);
+		msgh_id = kagura_rd32(&buf[20]);
+		msgh_bits = kagura_rd32(&buf[0]);
+	}
+	printf("KAGURA MACHMSG: proc=%s tid=%llu bits=0x%x sz=%u remote=0x%x local=0x%x id=0x%x\n",
+	    proc, (unsigned long long)thread_tid(current_thread()), msgh_bits,
+	    send_size, remote, local, msgh_id);
+
+	for (i = 0; i < len; ) {
+		if (buf[i] < 0x20 || buf[i] >= 0x7f) {
+			i++;
+			continue;
+		}
+		j = i;
+		while (i < len && buf[i] >= 0x20 && buf[i] < 0x7f)
+			i++;
+		n = i - j;
+		if (n < 5)
+			continue;
+		if (n > (int)sizeof(runbuf) - 1)
+			n = (int)sizeof(runbuf) - 1;
+		memcpy(runbuf, buf + j, (size_t)n);
+		runbuf[n] = '\0';
+		printf("KAGURA MACHMSG:  proc=%s run '%s'\n", proc, runbuf);
+	}
+}
+
